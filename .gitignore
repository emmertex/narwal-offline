# private key material — never commit
pki/*.key
pki/*.srl
pki/leaves/
tools/narwal_tokens.json
*.bak

# large build outputs — rebuild with apk/make-custom-apk.sh
apk/*.apk
apk/*.keystore
__pycache__/

# robot file dumps (large binaries; manifest + README stay)
robot_dump/*
!robot_dump/README.md
!robot_dump/probe_results.json
!robot_dump/oem_inventory_paths.txt
!robot_dump/etc_sysctl.conf.orig
!robot_dump/experiments/
!robot_dump/experiments/**

# decrypted firmware (2.6GB tree; keep on disk, commit manifests only)
robot_dump/firmware_plaintext/decrypted_e3.tar.gz
robot_dump/firmware_plaintext/fwback.tgz
robot_dump/firmware_plaintext/fw_prefix.tar
robot_dump/firmware_plaintext/npkg_extract/*/*/*.tar.gz
robot_dump/firmware_plaintext/npkg_extract/*/*/rootfs
robot_dump/firmware_plaintext/npkg_extract/*/*/oem
robot_dump/firmware_plaintext/npkg_extract/*/*/original
robot_dump/firmware_plaintext/npkg_extract/*/*/t1_mr813.swu
robot_dump/firmware_plaintext/rootfs_tree/
robot_dump/binaries/
